{
  "version": "2.1.0",
  "": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Foundation Validation Engine",
          "rules": [
            {
              "rule_id": "SEC-001-https-only",
              "domain": "security",
              "version": "1.0.0",
              "severity": "CRITICAL",
              "title": "Server URLs must use HTTPS only",
              "description": "Every entry in the OpenAPI \"servers\" array must have a \"url\" starting with \"https://\". Plain HTTP server URLs are rejected.\n",
              "purpose": "Prevents API traffic (including credentials and tokens sent by clients) from being transmitted over unencrypted HTTP, and stops an insecure server URL from being published as part of the contract that client tooling generates code against.\n",
              "requirement_id": null,
              "implementation": ".spectral.yaml (custom rule) via validators/openapi/ -> validators/run_all.py --spec",
              "evidence_type": "spec-lint-finding",
              "gate_behavior": "FAIL",
              "references": [
                "https://spec.openapis.org/oas/v3.0.3#server-object"
              ],
              "status": "active",
              "owner": "unassigned",
              "introduced_version": "1.1.0",
              "deprecated_version": null
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "OAS-001-path-kebab-case",
          "message": {
            "text": "Path must use kebab-case"
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "openapi.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-001-https-only",
          "message": {
            "text": "Servers must use HTTPS"
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "openapi.json"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}