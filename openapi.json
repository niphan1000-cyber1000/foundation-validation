{
  "openapi": "3.0.3",
  "info": {
    "title": "Bad Spec Test",
    "version": "1.0.0",
    "description": "API for retrieving user profile information.",
    "contact": {
      "name": "API Support",
      "email": "api-support@example.com"
    }
  },
  "servers": [
    { "url": "https://api.example.com/v1" }
  ],
  "tags": [
    {
      "name": "User Profiles",
      "description": "Operations for retrieving user profile information."
    }
  ],
  "paths": {
    "/user-profiles": {
      "get": {
        "operationId": "getUserProfiles",
        "summary": "Get user profiles",
        "description": "Returns a list of user profiles visible to the authenticated caller.",
        "tags": ["User Profiles"],
        "parameters": [
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error — invalid request or authentication failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error — the request could not be completed due to an internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "first_name": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
