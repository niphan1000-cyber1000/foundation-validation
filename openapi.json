{
  "openapi": "3.0.3",
  "info": {
    "title": "Bad Spec Test",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://api.example.com/v1" }
  ],
  "paths": {
    "/user_profiles": {
      "get": {
        "summary": "Get user profiles",
        "parameters": [
          {
