package policies.security

default allow = false

# ? 1: ?????? Authorization Header ?????????????? "Bearer "
allow {
    input.headers.authorization
    startswith(input.headers.authorization, "Bearer ")
}

# ? 2: ??????? password ???????? 8 ????????
deny_weak_password {
    input.body.password
    count(input.body.password) < 8
}
