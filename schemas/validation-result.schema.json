{
  "\": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationResultContract",
  "type": "object",
  "required": ["execution", "status", "summary", "findings", "evidence"],
  "properties": {
    "execution": {
      "type": "object",
      "required": ["execution_id", "timestamp", "platform_version", "environment"],
      "properties": {
        "execution_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "platform_version": { "type": "string" },
        "environment": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "ERROR"]
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_version", "severity", "category", "message", "location"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^(SCH|OAS|POL|SEC)-[A-Za-z0-9_-]+$" },
          "rule_version": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "category": { "type": "string", "enum": ["schema", "openapi", "policy", "security"] },
          "message": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["file", "path"],
            "properties": {
              "file": { "type": "string" },
              "path": { "type": "string" },
              "line": { "type": "integer" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["artifacts", "hash_digest"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "target_file", "rule_count"],
            "properties": {
              "domain": { "type": "string" },
              "target_file": { "type": "string" },
              "rule_count": { "type": "integer" }
            }
          }
        },
        "hash_digest": { "type": "string" }
      }
    }
  }
}
